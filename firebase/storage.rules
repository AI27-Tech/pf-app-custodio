rules_version = '2';

// Reglas de Storage del PLAN §5.3: los archivos viven en medios/{reporteId}/...,
// el custodio dueño del reporte puede CREAR la evidencia (una sola vez: ver S4);
// el analista del panel los puede LEER (es quien visualiza la evidencia); nada se
// borra y, sin que haga falta decirlo, nada se modifica.
//
// S3: el upload solo acepta los dos formatos que produce la app y dentro de un tope
// de tamaño razonable por tipo — `image/jpeg` de la foto (≤12 MB) y `audio/mp4` de
// la nota de voz (≤25 MB, una pista de 5 min nunca llega ahí). Cualquier otro
// contenido se rechaza sin llegar a escribirse.
//
// S4: una vez subido, el objeto es inmutable (`resource == null` == create). Esto
// cierra la puerta a que un atacante "recargue" evidencia sobre la misma ruta con
// un contenido distinto; el reintento del cliente se hace CONTRA LA AUSENCIA del
// objeto: si el get de metadata falla (404) vuelve a subir, y si el objeto ya
// existe, se salta. En la práctica los reintentos no escriben nada (la ruta ya
// existe), así que no hay tráfico de update que perder.
//
// Nota: para el custodio las ESCRITURAS solo consultan el reporte en Firestore (get()
// sobre un documento que ya existe), nunca la lista de analistas: subir evidencia no
// debe depender de `config/analistas` (ver quirk del emulador en firestore.rules).
// Un custodio además lee lo suyo vía `duenoDelReporte`; `esAnalista()` solo se
// evalúa cuando el `||` llega hasta ella (lector que no es dueño).
service firebase.storage {

  function autenticado() {
    return request.auth != null;
  }

  function duenoDelReporte(reporteId) {
    return firestore.get(/databases/(default)/documents/reportes/$(reporteId)).data.custodioUid == request.auth.uid;
  }

  // Misma noción que en firestore.rules: es analista quien tiene su correo en
  // `config/analistas.correos`.
  function esAnalista() {
    let lista = firestore.get(/databases/(default)/documents/config/analistas);
    return autenticado()
      && lista != null
      && 'correos' in lista.data
      && 'email' in request.auth.token
      && request.auth.token.email in lista.data.correos;
  }

  // S3: formato + tamaño de lo que la app produce (`CapturarMedio` y los sufijos
  // `.jpg` / `.m4a` de `RutasStorage`).
  function evidenciaValida() {
    return (request.resource.contentType == 'image/jpeg' && request.resource.size <= 12 * 1024 * 1024)
      || (request.resource.contentType == 'audio/mp4' && request.resource.size <= 25 * 1024 * 1024);
  }

  match /b/{bucket}/o {
    match /medios/{reporteId}/{fileName} {
      allow read: if autenticado() && (duenoDelReporte(reporteId) || esAnalista());

      // create-only (S4): `resource == null` garantiza que la ruta no existía. Para
      // el reintento idempotente ver FirebaseMedioRemoto (get de metadata -> 404).
      allow create: if autenticado()
        && duenoDelReporte(reporteId)
        && resource == null
        && evidenciaValida();

      allow update, delete: if false;
    }
  }
}
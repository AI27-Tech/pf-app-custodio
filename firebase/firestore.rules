rules_version = '2';

// Reglas de Firestore del PLAN §5.3 (revisadas para el modelo de dos roles):
// - Custodios (la app Android): escriben y leen SOLO lo suyo. Un reporte nace ACTIVO,
//   transiciona ACTIVO->CERRADO/DESCARTADO y en CERRADO solo avanzan contadores.
//   Los medios son create-only de su reporte. Nada se borra.
// - Analistas (el panel web, otra app): leen TODO, no escriben (garantía operativa:
//   el panel no expone escrituras y las cuentas de analista se provisionan a mano).
//
// Tanda del Grupo 2 (PLAN §16): las escrituras auditan la FORMA del documento contra
// el contrato real de `DocumentoMappers.kt` (S5: hasOnly + tipos + rangos), acotan los
// contadores de subida (S6) y permiten solo transiciones de ciclo explícitas (S7).
// Un reporte o medio que no se vea como lo produce la app se rechaza: se acabó la
// regla que "solo pedía lo mínimo".
//
// Decisión de diseño: las ESCRITURAS de custodio NO consultan `config/analistas`.
// Un custodio sube aunque el documento de analistas no exista —es justo lo que hace
// la app en un emulador recién iniciado— y evita el quirk del emulador que revienta
// una regla cuando un `get()` interno apunta a un documento inexistente. La prueba de
// analista solo se paga en lectura y solo cuando el documento consultado NO es del
// autor (`||` corta de izquierda a derecha).
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function esDuenoDe(recurso) {
      return recurso.data.custodioUid == request.auth.uid;
    }

    // El analista del panel de evidencia: lee todo, no escribe nada.
    //
    // La autorización sale de la lista de CORREOS en `config/analistas` (no de un
    // custom claim, que exigiría Admin SDK): un analista ES quien tiene su correo en
    // esa lista. Por eso agregar un analista es "añadir su correo a la lista".
    //
    // Clave: la condición NO depende del documento consultado. Las reglas de Firestore
    // no filtran consultas —si la condición mirara `resource`, una consulta de lista
    // falla entera en lugar de devolver menos resultados—, así que el analista se
    // autoriza por algo que el motor puede evaluar sin leer los documentos.
    //
    // `get()` devuelve null si el documento no existe, así que basta una lectura.
    function esAnalista() {
      let lista = get(/databases/$(database)/documents/config/analistas);
      return autenticado()
        && lista != null
        && 'correos' in lista.data
        && 'email' in request.auth.token
        && request.auth.token.email in lista.data.correos;
    }

    // Solo puede cambiar las llaves permitidas entre dos versiones del documento.
    function soloCambia(nuevas, anteriores, permitidas) {
      return nuevas.diff(anteriores).affectedKeys().hasOnly(permitidas);
    }

    // El custodio crea medios solo sobre un reporte suyo que ADMITA evidencia (un
    // reporte DESCARTADO no recibe más archivos). Un reporte inexistente devuelve
    // null y la regla falla: en el emulador el get() a un documento ausente corta con
    // "Service call error", que igualmente se traduce en denegar la escritura.
    function reportePermiteMediosDe(reporteId) {
      let reporte = get(/databases/$(database)/documents/reportes/$(reporteId));
      return reporte != null
        && reporte.data.custodioUid == request.auth.uid
        && reporte.data.ciclo != 'DESCARTADO';
    }

    // ---- S5: forma de un REPORTE (vale para create y para el doc resultante) ----
    // El conjunto de campos es el de `Reporte.aDocumentoFirestore()`. Los tipos son
    // los del dominio (`Reporte.kt`); `mediosEsperados` entra en el rango que la app
    // admite (Limites.MEDIOS_POR_REPORTE = 50) y 0..50. `mediosSubidos` no puede ser
    // negativo. `createdAtServer` admite el sentinel del SDK (en create el motor lo
    // resuelve a request.time y todavía no lo ve como timestamp).
    function camposDeReporteValidos(dato) {
      return dato.get('placas', '') is string
        && dato.get('placasCapturadas', '') is string
        && dato.get('custodioUid', '') is string
        && dato.get('custodioTelefono', '') is string
        && dato.get('clienteId', '') is string
        && dato.get('deviceId', '') is string
        && dato.get('fechaLocal', '') is string
        && dato.get('ciclo', '') in ['ACTIVO', 'CERRADO', 'DESCARTADO']
        && dato.get('subida', '') in ['PENDIENTE', 'EN_PROGRESO', 'COMPLETA', 'FALLIDA']
        && dato.get('completo', false) is bool
        && ('mediosEsperados' in dato
            ? dato.mediosEsperados == null
                || (dato.mediosEsperados is int
                    && dato.mediosEsperados >= 0
                    && dato.mediosEsperados <= 50)
            : true)
        && dato.get('mediosSubidos', 0) is int
        && dato.mediosSubidos >= 0
        && dato.get('schemaVersion', 1) is int
        && (!('resumenMedios' in dato)
            || (dato.resumenMedios is map
              && dato.resumenMedios.get('fotos', 0) is int
              && dato.resumenMedios.get('audios', 0) is int
              && dato.resumenMedios.get('durationMsTotal', 0) is int))
        && ('createdAtDevice' in dato
            ? dato.createdAtDevice is timestamp || dato.createdAtDevice == request.time
            : true)
        && (!('createdAtServer' in dato)
            || dato.createdAtServer == request.time
            || dato.createdAtServer is timestamp)
        && (!('closedAt' in dato) || dato.closedAt == null || dato.closedAt is timestamp)
        && (!('comentario' in dato) || dato.comentario == null || dato.comentario is string)
        && (!('motivoDescarte' in dato) || dato.motivoDescarte == null || dato.motivoDescarte is string)
        && dato.get('hayNovedad', false) is bool;
    }

    // ---- S5: forma de un MEDIO ----
    // Mismo enfoque con el contrato de `Medio.aDocumentoFirestore()`. La ruta de
    // miniatura y la del archivo viven SIEMPRE en `medios/{reporteId}/...` y el nombre
    // no puede introducir subcarpetas (`[^/]+`): eso fija el camino que la regla de
    // Storage sabe pedir (`match /medios/{reporteId}/{nombre}`). No se valida el
    // VOCABULARIO de `etiquetas` (vive en `catalogos`, es dinámico) pero sí su tipo.
    function camposDeMedioValidos(dato) {
      return dato.get('reporteId', '') is string
        && dato.get('tipo', '') in ['FOTO', 'AUDIO']
        && (!('etiquetas' in dato) || dato.etiquetas is list)
        && (!('storagePath' in dato)
            || (dato.storagePath is string
              && dato.storagePath.matches('medios/' + dato.get('reporteId', '') + '/[^/]+')))
        && (!('thumbnailPath' in dato)
            || dato.thumbnailPath == null
            || (dato.thumbnailPath is string
              && dato.thumbnailPath.matches('medios/' + dato.get('reporteId', '') + '/[^/]+')))
        && ('createdAtDevice' in dato
            ? dato.createdAtDevice is timestamp || dato.createdAtDevice == request.time
            : true)
        && (!('createdAtServer' in dato)
            || dato.createdAtServer == request.time
            || dato.createdAtServer is timestamp)
        && (!('gps' in dato)
            || dato.gps == null
            || (dato.gps is map
              && dato.gps.get('lat', 0) is number
              && dato.gps.get('lng', 0) is number
              && dato.gps.get('accuracyM', 0) is number
              && (('ageMs' in dato.gps) ? dato.gps.ageMs is int : true)))
        && (!('ubicacionTexto' in dato) || dato.ubicacionTexto == null || dato.ubicacionTexto is string)
        && (!('comentario' in dato) || dato.comentario == null || dato.comentario is string)
        && dato.get('contentType', '') is string
        && (!('sizeBytes' in dato) || dato.sizeBytes == null || dato.sizeBytes is int)
        && (!('durationMs' in dato) || dato.durationMs == null || dato.durationMs is int)
        && (!('sha256' in dato) || dato.sha256 == null || dato.sha256 is string)
        && dato.get('origen', '') in ['CAMARA', 'GRABADORA']
        && dato.get('placas', '') is string
        && dato.get('custodioUid', '') is string
        && dato.get('clienteId', '') is string
        && dato.get('fechaLocal', '') is string
        && dato.get('schemaVersion', 1) is int;
    }

    // S6/S7: el delta de un update no puede colar valores fuera de los enums ni
    // tipos equivocados en los campos sensibles (en el update NO se re-aplica
    // `camposDeReporteValidos` completa: el documento ya está fusionado y la forma se
    // audita en el create).
    function deltaDeFormaValido(nuevo) {
      return (!('ciclo' in nuevo) || nuevo.ciclo in ['ACTIVO', 'CERRADO', 'DESCARTADO'])
        && (!('subida' in nuevo) || nuevo.subida in ['PENDIENTE', 'EN_PROGRESO', 'COMPLETA', 'FALLIDA'])
        && (!('mediosSubidos' in nuevo) || nuevo.mediosSubidos is int)
        && (!('mediosEsperados' in nuevo)
            || nuevo.mediosEsperados == null
            || (nuevo.mediosEsperados is int && nuevo.mediosEsperados >= 0))
        && (!('completo' in nuevo) || nuevo.completo is bool)
        && (!('hayNovedad' in nuevo) || nuevo.hayNovedad is bool);
    }

    // S6: contadores de subida acotados y monótonos ----
    // `mediosSubidos` solo crece y no supera lo esperado (cuando se conoce: un reporte
    // nace ACTIVO sin `mediosEsperados`, que se fija al cerrar). `completo` debe ser
    // exactamente (subidos == esperados) una vez que hay referencia de esperados; antes
    // del cierre ese predicado sería imposible de evaluar, así que se exige false.
    function contadoresValidos(previo, nuevo) {
      // `mediosEsperados` nace null (create) y se fija al cerrar. Si el previo aún lo
      // tiene null, la referencia de esperados es la que llega en este update.
      let esperados = ('mediosEsperados' in nuevo && nuevo.mediosEsperados != null)
        ? nuevo.mediosEsperados
        : (('mediosEsperados' in previo && previo.mediosEsperados != null)
            ? previo.mediosEsperados
            : null);
      let monotono = !('mediosSubidos' in nuevo && 'mediosSubidos' in previo)
        || nuevo.mediosSubidos >= previo.mediosSubidos;
      let dentroCota = esperados == null
        || !('mediosSubidos' in nuevo)
        || nuevo.mediosSubidos <= esperados;
      let completoCoherente = esperados == null
        ? (!('completo' in nuevo) || nuevo.completo == false)
        : (!('completo' in nuevo)
            || nuevo.completo == ('mediosSubidos' in nuevo && nuevo.mediosSubidos == esperados));
      return monotono && dentroCota && completoCoherente;
    }

    match /reportes/{reporteId} {

      // `esAnalista()` va al final a propósito: `||` corta de izquierda a derecha, así
      // que un custodio leyendo lo suyo nunca llega a evaluarlo y no paga la lectura
      // extra de `config/analistas`. Sólo la paga quien falla la prueba de dueño.
      allow read: if autenticado()
        && (resource == null || esDuenoDe(resource) || esAnalista());

      // Un reporte siempre nace ACTIVO; el cierre offline llega como ACTIVO->CERRADO
      // en dos pasos desde la app (PLAN §6.2). Además del dueño, se exige el campo
      // `custodioTelefono` (PHONE_AUTH_PLAN): columna renombrada tras Task 1, y parte del
      // contrato de escritura —sin él la app no sabe de quién es el reporte en el historial.
      // S5: el create es la unica escritura que introduce un documento, así que aquí sí
      // puede exigir el conjunto exacto de campos (`hasOnly`).
      allow create: if autenticado()
        && esDuenoDe(request.resource)
        && 'custodioTelefono' in request.resource.data
        && request.resource.data.ciclo == 'ACTIVO'
        && request.resource.data.keys().hasOnly([
          'placas', 'placasCapturadas', 'custodioUid', 'custodioTelefono',
          'clienteId', 'deviceId', 'fechaLocal', 'createdAtDevice',
          'createdAtServer', 'ciclo', 'subida', 'completo', 'mediosEsperados',
          'mediosSubidos', 'resumenMedios', 'schemaVersion', 'closedAt',
          'comentario', 'hayNovedad', 'motivoDescarte',
        ])
        && camposDeReporteValidos(request.resource.data);

      // S7: cada transición admite SOLO las llaves que la app toca. El update ve el
      // documento ya fusionado (`request.resource.data`), así que la validez de forma
      // no se re-evalúa aquí: basta con acotar el delta y los contadores.
      function transicionValida() {
        let previo = resource.data;
        let nuevo = request.resource.data;
        let soloContadores = soloCambia(nuevo, previo, ['subida', 'mediosSubidos', 'completo']);
        let soloCierre = soloCambia(nuevo, previo, [
          'ciclo', 'closedAt', 'comentario', 'hayNovedad', 'mediosEsperados',
          'resumenMedios', 'subida', 'mediosSubidos', 'completo',
        ]);
        let soloDescarte = soloCambia(nuevo, previo, ['ciclo', 'closedAt', 'motivoDescarte']);
        let activoACerrado = previo.ciclo == 'ACTIVO' && nuevo.ciclo == 'CERRADO'
          && soloCierre && deltaDeFormaValido(nuevo) && contadoresValidos(previo, nuevo);
        let activoADescartado = previo.ciclo == 'ACTIVO' && nuevo.ciclo == 'DESCARTADO'
          && soloDescarte
          && 'motivoDescarte' in nuevo && nuevo.motivoDescarte is string;
        let activoContadores = previo.ciclo == 'ACTIVO' && nuevo.ciclo == 'ACTIVO'
          && soloContadores && deltaDeFormaValido(nuevo) && contadoresValidos(previo, nuevo);
        let cerradoContadores = previo.ciclo == 'CERRADO' && nuevo.ciclo == 'CERRADO'
          && soloContadores && deltaDeFormaValido(nuevo) && contadoresValidos(previo, nuevo);
        return activoACerrado || activoADescartado || activoContadores || cerradoContadores;
      }

      allow update: if autenticado() && esDuenoDe(resource) && transicionValida();
      allow delete: if false;
    }

    match /medios/{medioId} {

      allow read: if autenticado()
        && (resource == null || esDuenoDe(resource) || esAnalista());

      // S5: create-only y con la forma exacta del medio; la ruta no puede apuntar a
      // otro reporte (el `storagePath` debe nacer bajo `medios/{reporteId}/...`).
      allow create: if autenticado()
        && esDuenoDe(request.resource)
        && reportePermiteMediosDe(request.resource.data.reporteId)
        && request.resource.data.keys().hasOnly([
          'reporteId', 'tipo', 'etiquetas', 'storagePath', 'thumbnailPath',
          'createdAtDevice', 'createdAtServer', 'gps', 'ubicacionTexto',
          'comentario', 'contentType', 'sizeBytes', 'durationMs', 'sha256',
          'origen', 'placas', 'custodioUid', 'clienteId', 'fechaLocal',
          'schemaVersion',
        ])
        && camposDeMedioValidos(request.resource.data);

      allow update, delete: if false;
    }

    match /catalogos/{catalogo} {
      allow read: if autenticado();
    }

    match /usuarios/{uid} {
      // El analista lee el directorio para poblar el filtro de custodio del panel.
      allow read: if autenticado() && (request.auth.uid == uid || esAnalista());
      allow create: if autenticado() && request.auth.uid == uid;
    }

    // Configuración administrada desde la consola o el emulador y que ningún cliente
    // modifica. Las reglas sí las leen: `get()` dentro de una regla corre con acceso
    // total y no se evalúa a sí misma, así que negar aquí no rompe `esAnalista()`.
    //
    // La allowlist de teléfonos (`config/telefonos.telefonos`, PHONE_AUTH_PLAN Task 4)
    // ES la excepción que sí lee la app: cada custodio la consulta (solo lectura) tras
    // autenticar su número por SMS. La lista la administra el Admin SDK / la consola.
    match /config/telefonos {
      allow read: if autenticado();
      allow write: if false;
    }

    match /config/{documento} {
      allow read, write: if false;
    }

    // Cómo administrar la lista de analistas (config/analistas.correos, un correo a la
    // vez, en minúsculas como los normaliza Firebase Auth):
    //   - Producción: Consola Firebase -> Firestore -> documento `config/analistas`.
    //   - Emulador: Emulator UI (http://127.0.0.1:4000/firestore) o REST con token de dueño:
    //       curl -X POST http://127.0.0.1:8080/v1/projects/<PROYECTO>/databases/(default)/documents/config?documentId=analistas \
    //            -H "Authorization: Bearer owner" \
    //            -d '{"fields":{"correos":{"arrayValue":{"values":[{"stringValue":"ana@ai27.mx"}]}}}}'
  }
}
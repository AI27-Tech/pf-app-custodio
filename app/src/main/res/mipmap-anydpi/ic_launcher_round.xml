<?xml version="1.0" encoding="utf-8"?>
<!--
  Mismas capas que `ic_launcher.xml`; se conserva el recurso aparte porque el manifest
  lo declara en `android:roundIcon` y porque hay lanzadores de API 26/27 que lo piden
  directamente. Ver la nota de `ic_launcher.xml` sobre por que no hay mapas de bits
  de respaldo.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
